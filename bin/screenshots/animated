#!/bin/sh
# The README's animation: a GIF in a 1000x600 window, opened stopped on its
# first frame, then played through once with the transport bar under it.
# The film is cut to one loop of the file from the moment play was pressed,
# so the GIF made from it loops where the file does.
#
#   bin/screenshots/animated            on ~/Downloads/stellated-dodecahedron.gif
#   bin/screenshots/animated FILE       on another animation

. "$(dirname "$0")/lib.sh"

file=${1:-$HOME/Downloads/stellated-dodecahedron.gif}

# One loop, in seconds: the frame delays are in hundredths.
loop=$(magick identify -format '%T\n' "$file" | awk '{ s += $1 } END { print s / 100 }')

open 1000 600 --paused "$file"
record "$ROOT/target/screenshots/animated.mp4"
started=$(since_record)
keys Return
sleep "$loop"
settle
film=$(cut)
close
gif "$film" "$ROOT/user-docs/screenshots/animated.gif" 800 "$started" "$loop"

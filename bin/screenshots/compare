#!/bin/sh
# The README's comparison: the three rasters of one mountain flipped
# through in a 1000x600 window — the elevation model, the hillshade, the
# shaded relief — the wheel rolled over the crater to about 100% on the
# third, and the flip back; the files are of a size, so the zoom follows.
#
#   bin/screenshots/compare            on ~/git/mora
#   bin/screenshots/compare DIR X Y    on another directory, zooming into pixel X, Y of its second file

. "$(dirname "$0")/lib.sh"

dir=${1:-$HOME/git/mora}
x=${2:-2340}
y=${3:-2260}

open 1000 600 "$dir"
keys bracketright
loaded
set -- $(window title)
set -- $(magick identify -format '%w %h' "$dir/$1")

record "$ROOT/target/screenshots/compare.mp4" cursor
started=$(since_record)
# After `record`, which parks the pointer on the bar: it has to be over
# the crater for the wheel, and it stays there for the whole film.
cursor $(fitted "$1" "$2" "$x" "$y")
sleep 1
keys bracketright
sleep 1
keys bracketright
sleep 1
# Seven notches from a fit of 23% is 109%.
wheel 7
# A second here too, less the 400 ms the wheel waits for its device.
sleep 0.6
keys bracketleft
sleep 1
keys bracketleft
sleep 1
film=$(cut)
close
gif "$film" "$ROOT/user-docs/screenshots/compare.gif" 800 "$started"

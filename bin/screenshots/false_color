#!/bin/sh
# The README's false color: the hillshade of the mountain in a 1000x600
# window, zoomed to about 100% over the crater, and `r` pressed through the
# four color maps — gray, viridis, magma, turbo — a second on each. The
# zoom is done before the film starts; the film is the colors.
#
#   bin/screenshots/false_color            on ~/git/mora
#   bin/screenshots/false_color DIR X Y    on another directory, zooming into pixel X, Y of its third file

. "$(dirname "$0")/lib.sh"

dir=${1:-$HOME/git/mora}
x=${2:-2340}
y=${3:-2260}

open 1000 600 "$dir"
keys bracketright bracketright
loaded
set -- $(window title)
set -- $(magick identify -format '%w %h' "$dir/$1")
cursor $(fitted "$1" "$2" "$x" "$y")
sleep 0.3
# Seven notches from a fit of 23% is 109%.
wheel 7
settle

record "$ROOT/target/screenshots/false_color.mp4"
started=$(since_record)
sleep 1
keys r
sleep 1
keys r
sleep 1
keys r
sleep 1
film=$(cut)
close
gif "$film" "$ROOT/user-docs/screenshots/false_color.gif" 800 "$started"

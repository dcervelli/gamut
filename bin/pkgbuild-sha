#!/bin/sh
# Point the PKGBUILD at a published release and record its tarball's
# checksum. And once the release workflow has attached the signed Mac
# application to the release, record the zip's checksum in the Homebrew
# cask and copy the cask into the tap, the homebrew-gamut repository beside
# this one, or wherever GAMUT_TAP names.
#
# Separate from `bin/release` because it can only run once the tag has been
# pushed and the release workflow has produced the source tarball. GitHub can
# lag a few seconds behind the tag, so the download is retried.
#
#   bin/pkgbuild-sha v0.1.0

set -eu

[ $# -eq 1 ] || { echo "usage: bin/pkgbuild-sha vX.Y.Z" >&2; exit 2; }

# A SHA-256 as hex, from `sha256sum` where it is installed and `shasum`,
# which is what macOS ships, where it is not.
sha256() {
    if command -v sha256sum >/dev/null; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

cd "$(dirname "$0")/.."

TAG=$1
VERSION=${TAG#v}
NAME=$(sed -n 's/^name = "\(.*\)"$/\1/p' Cargo.toml | head -1)
URL=$(sed -n 's/^url="\(.*\)"$/\1/p' packaging/PKGBUILD | head -1)
TARBALL="$URL/archive/refs/tags/$TAG.tar.gz"

for tool in curl tar awk; do
    command -v "$tool" >/dev/null || { echo "$tool is not installed" >&2; exit 1; }
done

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

echo "fetching $TARBALL"
n=0
until curl -fsSL "$TARBALL" -o "$TMP/src.tar.gz"; do
    n=$((n + 1))
    [ "$n" -lt 5 ] || { echo "could not download the tarball" >&2; exit 1; }
    sleep 3
done

# What makepkg will unpack has to be the directory the PKGBUILD cd's into.
tar tzf "$TMP/src.tar.gz" | head -1 | grep -q "^$NAME-$VERSION/" || {
    echo "the tarball does not open into $NAME-$VERSION/" >&2
    exit 1
}

SHA=$(sha256 "$TMP/src.tar.gz")
echo "sha256 $SHA"

# Only the first sha256sums entry belongs to the tarball.
awk -v v="$VERSION" -v sha="$SHA" -v q="'" '
    /^pkgver=/ { print "pkgver=" v; next }
    !hashed && /^sha256sums=/ { sub(q "[^" q "]*" q, q sha q); hashed = 1 }
    { print }
' packaging/PKGBUILD >packaging/PKGBUILD.new && mv packaging/PKGBUILD.new packaging/PKGBUILD

bash -n packaging/PKGBUILD
echo "packaging/PKGBUILD now points at $TAG"

TAP=${GAMUT_TAP:-../homebrew-gamut}

# The cask names the Mac application the release workflow signs, notarizes
# and attaches to the release, which takes some minutes after the tag:
# where it is not there yet, the cask is left for a second run.
ZIP_URL="$URL/releases/download/$TAG/Gamut-$VERSION-arm64.zip"
echo "fetching $ZIP_URL"
if curl -fsSL "$ZIP_URL" -o "$TMP/app.zip"; then
    ZIP_SHA=$(sha256 "$TMP/app.zip")
    echo "sha256 $ZIP_SHA"
    awk -v v="$VERSION" -v sha="$ZIP_SHA" '
        /^  version "/ { print "  version \"" v "\""; next }
        /^  sha256 "/ { sub(/"[0-9a-f]*"/, "\"" sha "\"") }
        { print }
    ' packaging/cask.rb >packaging/cask.rb.new && mv packaging/cask.rb.new packaging/cask.rb
    echo "packaging/cask.rb now points at $TAG"
    if [ -d "$TAP" ]; then
        mkdir -p "$TAP/Casks"
        cp packaging/cask.rb "$TAP/Casks/gamut.rb"
        echo "copied into $TAP/Casks/gamut.rb; commit and push it there"
    else
        echo "no tap at $TAP: copy packaging/cask.rb into its Casks/gamut.rb by hand" >&2
    fi
else
    echo "the release has no Mac application yet: run this again once the" >&2
    echo "release workflow's Mac job is done, to point the cask at it" >&2
fi

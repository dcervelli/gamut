#!/bin/sh
# Point the PKGBUILD and the Homebrew formula at a published release and
# record its checksum, which is the same tarball's in both; then copy the
# formula into the tap, the homebrew-gamut repository beside this one, or
# wherever GAMUT_TAP names.
#
# Separate from `bin/release` because it can only run once the tag has been
# pushed and the release workflow has produced the source tarball. GitHub can
# lag a few seconds behind the tag, so the download is retried.
#
#   bin/pkgbuild-sha v0.1.0

set -eu

[ $# -eq 1 ] || { echo "usage: bin/pkgbuild-sha vX.Y.Z" >&2; exit 2; }

# A SHA-256 as hex, from `sha256sum` where it is installed and `shasum`,
# which is what macOS ships, where it is not.
sha256() {
    if command -v sha256sum >/dev/null; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

cd "$(dirname "$0")/.."

TAG=$1
VERSION=${TAG#v}
NAME=$(sed -n 's/^name = "\(.*\)"$/\1/p' Cargo.toml | head -1)
URL=$(sed -n 's/^url="\(.*\)"$/\1/p' packaging/PKGBUILD | head -1)
TARBALL="$URL/archive/refs/tags/$TAG.tar.gz"

for tool in curl tar awk; do
    command -v "$tool" >/dev/null || { echo "$tool is not installed" >&2; exit 1; }
done

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

echo "fetching $TARBALL"
n=0
until curl -fsSL "$TARBALL" -o "$TMP/src.tar.gz"; do
    n=$((n + 1))
    [ "$n" -lt 5 ] || { echo "could not download the tarball" >&2; exit 1; }
    sleep 3
done

# What makepkg will unpack has to be the directory the PKGBUILD cd's into.
tar tzf "$TMP/src.tar.gz" | head -1 | grep -q "^$NAME-$VERSION/" || {
    echo "the tarball does not open into $NAME-$VERSION/" >&2
    exit 1
}

SHA=$(sha256 "$TMP/src.tar.gz")
echo "sha256 $SHA"

# Only the first sha256sums entry belongs to the tarball.
awk -v v="$VERSION" -v sha="$SHA" -v q="'" '
    /^pkgver=/ { print "pkgver=" v; next }
    !hashed && /^sha256sums=/ { sub(q "[^" q "]*" q, q sha q); hashed = 1 }
    { print }
' packaging/PKGBUILD >packaging/PKGBUILD.new && mv packaging/PKGBUILD.new packaging/PKGBUILD

bash -n packaging/PKGBUILD
echo "packaging/PKGBUILD now points at $TAG"

awk -v v="$VERSION" -v sha="$SHA" '
    /^  url "/ { sub(/\/v[^\/]*\.tar\.gz"/, "/v" v ".tar.gz\"") }
    /^  sha256 "/ { sub(/"[0-9a-f]*"/, "\"" sha "\"") }
    { print }
' packaging/gamut.rb >packaging/gamut.rb.new && mv packaging/gamut.rb.new packaging/gamut.rb
echo "packaging/gamut.rb now points at $TAG"

# The tap is what Homebrew reads, and it holds a copy. Copied whole: a bottle
# block the tap's workflow added is for the previous version, and goes.
TAP=${GAMUT_TAP:-../homebrew-gamut}
if [ -d "$TAP/Formula" ]; then
    cp packaging/gamut.rb "$TAP/Formula/gamut.rb"
    echo "copied into $TAP/Formula/gamut.rb; commit and push it there"
else
    echo "no tap at $TAP: copy packaging/gamut.rb into its Formula/ by hand" >&2
fi

[Desktop Entry]
Type=Application
Version=1.5
Name=Gamut
GenericName=Image Viewer
Comment=An image viewer optimized for getting work done, fast
Exec=gamut %F
TryExec=gamut
Icon=com.dcervelli.gamut
Terminal=false
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;
Keywords=image;photo;picture;viewer;hdr;exr;tiff;jxl;raw;colour;color;
StartupNotify=true
StartupWMClass=com.dcervelli.gamut
MimeType=inode/directory;image/jpeg;image/png;image/apng;image/gif;image/bmp;image/tiff;image/webp;image/jxl;image/avif;image/heif;image/heic;image/vnd.microsoft.icon;image/vnd.radiance;image/x-hdr;image/x-exr;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-portable-arbitrarymap;image/x-adobe-dng;image/x-nikon-nef;image/x-nikon-nrw;image/x-canon-cr2;image/x-canon-cr3;image/x-canon-crw;image/x-sony-arw;image/x-sony-srf;image/x-sony-sr2;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-pentax-pef;image/x-samsung-srw;image/x-hasselblad-3fr;image/x-hasselblad-fff;image/x-phaseone-iiq;image/x-mamiya-mef;image/x-leaf-mos;image/x-epson-erf;image/x-kodak-dcr;image/x-kodak-kdc;image/x-minolta-mrw;image/x-dcraw;

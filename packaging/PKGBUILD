# Maintainer: TODO <TODO>

pkgname=gamut
# The name the desktop knows the program by: the Wayland app_id, and so the
# basename the entry and the icon have to be filed under for a taskbar to pair
# a window with its icon. `main.rs::APP_ID` is where it is set, and `cli`'s
# tests check that this file still agrees with it.
_appid=com.dcervelli.gamut
pkgver=0.1.0
pkgrel=1
pkgdesc="A modern image viewer optimized for getting work done, fast."
arch=('x86_64' 'aarch64')
url="https://github.com/closedcontour/gamut"
# gamut itself, then the licenses of the work carried in its own source tree:
# Lucide's icon geometry, and the two colormap fits. REUSE.toml says which file
# is which. The crates linked into the binary are not gamut's source and do not
# belong here; their notices ship as THIRD-PARTY-NOTICES.
license=('MIT OR Apache-2.0' 'ISC' 'CC0-1.0' 'Apache-2.0')
# libheif reads HEIC and AVIF, and its codec plugins decide which of the two
# actually work: libde265 or ffmpeg for HEVC, dav1d or aom for AV1. Both are
# ordinary on Arch, so they are left to libheif's own dependencies.
# vulkan-icd-loader finds the driver wgpu draws through; fontconfig is how the
# interface finds a sans and a mono face to set its text in.
depends=('gcc-libs' 'glibc' 'libheif' 'vulkan-icd-loader' 'fontconfig')
makedepends=('cargo' 'pkgconf')
options=('!debug')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"

  # The tests that want a GPU report success where no adapter can be had, so
  # this is safe in a build container. `test_images/` ships in the tarball
  # because the tests reach for it by path.
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

  # gamut's own license, and then the record of everything else the binary
  # carries: REUSE.toml names the file each license applies to, and LICENSES/
  # holds the texts it names.
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 REUSE.toml "$pkgdir/usr/share/licenses/$pkgname/REUSE.toml"
  for text in LICENSES/*.txt; do
    install -Dm644 "$text" "$pkgdir/usr/share/licenses/$pkgname/$text"
  done
  # And the crates statically linked into the binary. Generated at release time
  # rather than here, and committed: `cargo about` is packaged neither in the
  # repositories nor in the AUR, so generating it here would mean installing
  # the tool from crates.io first — unpinned, and over the network. Generation
  # is otherwise offline and deterministic, so the committed file can be
  # checked by regenerating it and diffing.
  install -Dm644 THIRD-PARTY-NOTICES \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 user-docs/KEYS.md "$pkgdir/usr/share/doc/$pkgname/KEYS.md"
  install -Dm644 user-docs/FORMATS.md "$pkgdir/usr/share/doc/$pkgname/FORMATS.md"

  install -Dm644 "packaging/$_appid.desktop" \
    "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "packaging/$_appid.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_appid.svg"

  # The manual page and the completions come out of the binary just built, so
  # they cannot describe a different version of the program than the one being
  # packaged.
  "target/release/$pkgname" --print-man |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/man/man1/$pkgname.1"

  install -Dm644 "packaging/completions/$pkgname.bash" \
    "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  install -Dm644 "packaging/completions/_$pkgname" \
    "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
  install -Dm644 "packaging/completions/$pkgname.fish" \
    "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"
}
